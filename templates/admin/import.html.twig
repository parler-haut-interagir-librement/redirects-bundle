{% extends layout %}

{% block title %}{{ 'title.import'|trans({}, 'phil_redirects') }}{% endblock %}

{% block content %}
    <h1>{{ 'title.import'|trans({}, 'phil_redirects') }}</h1>
    {{ include('@PhilRedirects/admin/_nav.html.twig') }}

    {{ include('@PhilRedirects/admin/_error.html.twig') }}

    {% if report %}
        <p role="status">{{ (report.dryRun ? 'import.dry_run_summary' : 'import.summary')|trans({'%created%': report.created, '%updated%': report.updated, '%skipped%': report.skipped|length, '%rejected%': report.rejected|length}, 'phil_redirects') }}</p>
        {% if report.rejected %}
            <ul>
                {% for line, reason in report.rejected %}
                    <li>{{ 'import.line'|trans({'%line%': line}, 'phil_redirects') }} {{ reason }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}

    <p>{{ 'help.csv'|trans({}, 'phil_redirects') }}</p>

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <p>
            <label for="phil-redirects-file">{{ 'field.file'|trans({}, 'phil_redirects') }}</label>
            <input type="file" id="phil-redirects-file" name="file" accept=".csv,text/csv" required>
        </p>
        <p><label><input type="checkbox" name="update" value="1"> {{ 'field.update'|trans({}, 'phil_redirects') }}</label></p>
        <p><label><input type="checkbox" name="dry_run" value="1" checked> {{ 'field.dry_run'|trans({}, 'phil_redirects') }}</label></p>
        <button type="submit">{{ 'action.import'|trans({}, 'phil_redirects') }}</button>
    </form>
{% endblock %}
